#!/usr/bin/env bash
set -euo pipefail

# Amp orb resume for mampf: fast (<10s), idempotent repair only.
# Never installs dependencies; setup owns that.

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Recreate missing local credentials without rotating an existing secret.
[ -f .dev.vars ] || (umask 077; printf 'PIN=1234\n' > .dev.vars)
if ! grep -q '^SESSION_SECRET=' .dev.vars; then
  (umask 077; printf '\nSESSION_SECRET=%s\n' "$(node -e 'process.stdout.write(require("node:crypto").randomBytes(32).toString("hex"))')" >> .dev.vars)
fi

# Regenerate worker types only if missing (cheap repair, no-op when present).
if [ ! -f worker-configuration.d.ts ]; then
  pnpm cf-typegen >/dev/null 2>&1 || true
fi
