#!/usr/bin/env bash
set -euo pipefail

# Amp orb setup for mampf: toolchain check, dependencies, typegen, local D1.
# Idempotent and safe to re-run on a warm snapshot.

cd "$(dirname "${BASH_SOURCE[0]}")/.."
repo_root="$PWD"

step() {
  local name="$1"; shift
  local start=$SECONDS
  echo "==> ${name}"
  "$@"
  echo "    done in $((SECONDS - start))s"
}

# --- Toolchain (preinstalled in the orb base image; install only if missing) ---
ensure_toolchain() {
  if ! command -v node >/dev/null 2>&1; then
    echo "Node.js missing, installing Node 22 via NodeSource..."
    apt-get update -qq
    apt-get install -y -qq ca-certificates curl gnupg
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
    apt-get install -y -qq nodejs
  fi
  if ! command -v pnpm >/dev/null 2>&1; then
    corepack enable
  fi
  corepack prepare pnpm@12.1.0 --activate
  if ! command -v vp >/dev/null 2>&1; then
    echo "Vite+ missing, installing vp..."
    curl -fsSL https://vite.plus | bash
  fi
  export PATH="$HOME/.local/share/vite-plus/bin:$PATH"
  node --version
  pnpm --version
  vp --version
}
step "toolchain" ensure_toolchain

step "dependencies" pnpm install --frozen-lockfile

# Point origin at GitHub instead of Amp's checkout proxy, so pushes and pulls
# go straight to GitHub in future orbs.
step "git remote" git remote set-url origin https://github.com/mooxl/mampf.git

# Local dev credentials, never production secrets (gitignored).
if [ ! -f .dev.vars ]; then
  (umask 077; printf 'PIN=1234\n' > .dev.vars)
  echo "==> created .dev.vars with the default local dev PIN (1234)"
fi
if ! grep -q '^SESSION_SECRET=' .dev.vars; then
  (umask 077; printf '\nSESSION_SECRET=%s\n' "$(node -e 'process.stdout.write(require("node:crypto").randomBytes(32).toString("hex"))')" >> .dev.vars)
  echo "==> generated local session signing secret"
fi

# Regenerate types after creating local secret bindings (gitignored).
step "typegen" pnpm cf-typegen

# Apply D1 migrations to the local miniflare database.
# Re-runs are cheap: wrangler skips already-applied migrations.
export CI=true
export WRANGLER_SEND_METRICS=false
step "d1 local migrations" pnpm db:migrate:local

# Orb-specific agent guidance (login hint), appended once.
agents_md="$HOME/.config/amp/AGENTS.md"
marker="# mampf orb notes"
if ! grep -Fqx "$marker" "$agents_md" 2>/dev/null; then
  cat >> "$agents_md" <<EOF

$marker
- Local dev PIN for the mampf app is 1234 (set in the gitignored .dev.vars).
- The dev server runs as the supervised "mampf" service; use the portal URL
  Amp prints (never a raw localhost URL) to open the app.
EOF
  echo "==> appended mampf notes to $agents_md"
fi

echo "==> setup complete"
