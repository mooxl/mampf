{
  "name": "mampf",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && tsc --noEmit",
    "preview": "vp preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply mampf-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mampf-db --remote"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0-rc.112",
    "@effect/sql-d1": "rc",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "effect": "rc",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.29.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.8.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.74.0"
  },
  "packageManager": "pnpm@12.0.0"
